# Repositórios próprios, versionados à parte
backend/
frontend/

# Enunciado da prática: contém a senha padrão da turma, e senha não entra
# no histórico do git (regra da prática e docs/rules/secrets.md)
atividade/

# Segredos
.env
.env.*
!.env.example

# Configuração pessoal do Claude Code
.claude/settings.local.json

# Dependências da raiz (sharp, ADR-002)
node_modules/

# Skill imagens-equipamentos: fotos prontas, página de revisão e cache da
# API ficam fora do git. Só o manifesto (escolhas e créditos) é versionado.
imagens/*
!imagens/manifesto.json

# Sistema operacional e editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
