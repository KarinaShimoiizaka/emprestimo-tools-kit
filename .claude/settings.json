{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(/docs/verificacoes/**)",

      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git stash *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npx prisma migrate *)",
      "Bash(npx prisma db *)",
      "Bash(npm run prisma *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",

      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git pull *)",
      "PowerShell(git fetch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset *)",
      "PowerShell(git stash *)",
      "PowerShell(git revert *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git tag *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npx prisma migrate *)",
      "PowerShell(npx prisma db *)",
      "PowerShell(npm run prisma *)",
      "PowerShell(vercel *)",
      "PowerShell(npx vercel *)",
      "PowerShell(supabase *)",
      "PowerShell(npx supabase *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guarda-comandos.js"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/exige-verificacao.js"],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/registra-verificacao.js"]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "verificador-spec",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/registra-verificacao.js"]
          }
        ]
      }
    ]
  }
}
